#!/usr/bin/env bash
set -euo pipefail
script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
  app_dir="$(cd -- "$(dirname -- "$script")" && pwd -P)"
  script="$(readlink "$script")"
  [[ "$script" = /* ]] || script="$app_dir/$script"
done
app_dir="$(cd -- "$(dirname -- "$script")" && pwd -P)"
if [[ ! -x "$app_dir/.venv/bin/python" ]]; then
  printf 'Create the CamLink virtual environment first; see %s/README.md\n' "$app_dir" >&2
  exit 1
fi
exec "$app_dir/.venv/bin/python" "$app_dir/app.py" "$@"
